# Domínio base desta stack (pode diferir do DOMAIN em ~/infra/.env).
# Traefik: minharotina-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="Minha Rotina"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://minharotina-api.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=minha_rotina
DB_USERNAME=minha_rotina
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Frontend (PWA) — CORS e links de recuperação de senha
FRONTEND_URL=https://minharotina.noxtecnologias.com.br
CORS_ALLOWED_ORIGINS=https://minharotina.noxtecnologias.com.br

# Token de sessão em cookie HttpOnly (a API também aceita Bearer)
AUTH_COOKIE_NAME=mr_token
AUTH_COOKIE_MINUTES=43200
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Web Push (VAPID) — gerar com: php artisan rotina:vapid-keys
VAPID_SUBJECT=mailto:contato@noxtecnologias.com.br
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Gamificação
POINTS_PER_LEVEL=100
WEEKLY_POINTS_GOAL=300
MONTHLY_POINTS_GOAL=1200
