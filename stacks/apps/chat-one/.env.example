# Domínio base desta stack (pode diferir do DOMAIN em ~/infra/.env).
# Traefik: chatone-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="ChatOne"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://chatone-api.noxtecnologias.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=chat_one
DB_USERNAME=chatone
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FRONTEND_URL=https://chatone.noxtecnologias.com.br
SANCTUM_STATEFUL_DOMAINS=chatone.noxtecnologias.com.br

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Rede interna Docker — não usar o domínio público aqui.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_PUBLIC_KEY=
WHATSAPP_SECRET_KEY=
WHATSAPP_DAPI_BASE_URL=https://api.d-api.cloud
WHATSAPP_DAPI_CONNECT_BASE_URL=https://connect-c2.d-api.cloud
WHATSAPP_DAPI_CONNECT_MODE=coexistence
WHATSAPP_DAPI_KEEP_POPUP_ON_ERROR=false
WHATSAPP_WEBHOOK_BASE_URL=https://chatone-api.noxtecnologias.com.br

BILLING_DAYS_BEFORE_DUE=3
BILLING_PAYMENT_WINDOW_DAYS=3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_USER_AGENT=NoxConnect/1.0
ASAAS_TIMEOUT=30
ASAAS_CREDIT_CARD_TIMEOUT=60
WEBHOOK_TOKEN=
