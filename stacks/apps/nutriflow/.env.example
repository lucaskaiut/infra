# Domínio base desta stack. Traefik: nutriflow-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="NutriFlow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://nutriflow-api.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nutriflow
DB_USERNAME=nutriflow
DB_PASSWORD=

# App mobile (Expo) usa tokens Bearer; FRONTEND_URL só libera CORS para uma versão web futura.
FRONTEND_URL=https://nutriflow.noxtecnologias.com.br

SESSION_DRIVER=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Código de recuperação de senha. Com "log" o e-mail NÃO é entregue: configure SMTP real
# (MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_SCHEME) quando houver.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

ASSISTANT_ENABLED=false

# Login com Google: Client IDs OAuth (web, iOS, Android) separados por vírgula. Vazio = botão escondido.
GOOGLE_CLIENT_IDS=
