# Domínio base desta stack
DOMAIN=noxtecnologias.com.br

APP_NAME="Local Build Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://runner.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=build_runner
DB_USERNAME=build_runner
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Painel publicado na Vercel (mesma origem via rewrites do vercel.json).
SANCTUM_STATEFUL_DOMAINS=builds.noxtecnologias.com.br

TRUSTED_PROXIES=*

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

BUILD_LEASE_SECONDS=180
RUNNER_OFFLINE_SECONDS=120
BUILD_LOG_MAX_LINES=100000
BUILD_LOG_MAX_MESSAGE_BYTES=8192
BUILD_LOG_MAX_BATCH_EVENTS=500
BUILD_LOG_RETENTION_DAYS=90
BUILD_ARTIFACT_MAX_MB=512
BUILD_ARTIFACT_RETENTION_DAYS=30
BUILD_DEFAULT_TIMEOUT=3600
BUILD_MAX_TIMEOUT=21600
BUILD_RECORD_RETENTION_DAYS=180
