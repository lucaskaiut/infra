DOMAIN=lucaskaiut.com.br
APP_NAME="Toth CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://toth-api.lucaskaiut.com.br

LOG_CHANNEL=stack
