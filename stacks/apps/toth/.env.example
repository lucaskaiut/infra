DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=toth
DB_USERNAME=ematricula
DB_PASSWORD=mesmo_valor_que_MYSQL_PASSWORD_em_stacks_shared

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=toth_

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=toth
REVERB_APP_KEY=gerar_secret_forte
REVERB_APP_SECRET=gerar_secret_forte
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

POSTGRES_VECTOR_DATABASE=toth_vectors
POSTGRES_VECTOR_USERNAME=toth
POSTGRES_VECTOR_PASSWORD=gerar_senha_forte_postgres_vector
