# =============================================================================
# Financeiro Borcath Backup — Cloudflare R2 credentials
# =============================================================================
# Copie para .env.backup e preencha com os valores reais.
# NUNCA comite o .env.backup real!

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=<seu_access_key_id>
R2_SECRET_ACCESS_KEY=<seu_secret_access_key>
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=<seu_bucket>

# --- MySQL (opcional — sobrescreve os defaults) ---
# MYSQL_CONTAINER=<nome_ou_id_do_container_mysql>
# MYSQL_DATABASE=financeiro_borcath
# MYSQL_USER=root
# MYSQL_PASSWORD=<se preferir definir explicitamente>

# --- Storage (opcional) ---
# APP_CONTAINER=<nome_ou_id_do_container_app>
# APP_STORAGE_PATH=/var/www/html/storage/app/public

# --- Retenção ---
# BACKUP_ROOT=/home/kaiut/backups/financeiro-borcath
# RETENTION_HOURS=24

# =============================================================================
# Instruções de deploy
# =============================================================================
# 1. Copie este arquivo para .env.backup e preencha as credenciais R2
#    cp .env.backup.example .env.backup
#    chmod 600 .env.backup
#
# 2. Teste o script manualmente:
#    ./backup.sh .env.backup
#
# 3. O cron está configurado no crontab da VPS (0 */8 * * *):
#    crontab -l  # para verificar
#    crontab -e  # para editar
#
# 4. Logs ficam em $BACKUP_ROOT/backup.log
