# Domínio base desta stack (pode diferir do DOMAIN em ~/infra/.env).
# Traefik: monensure-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="Monensure"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://monensure-api.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=monensure
DB_USERNAME=monensure
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://monensure.noxtecnologias.com.br
SANCTUM_STATEFUL_DOMAINS=monensure.noxtecnologias.com.br

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Billing
BILLING_DAYS_BEFORE_DUE=3
BILLING_PAYMENT_WINDOW_DAYS=3
BILLING_RECURRING_CHARGE_MAX_ATTEMPTS=3
BILLING_RECURRING_CHARGE_RETRY_DELAY_MS=500
BILLING_RECURRING_REMOTE_IP=127.0.0.1

# Asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_USER_AGENT=Monensure/1.0
ASAAS_TIMEOUT=30
ASAAS_CREDIT_CARD_TIMEOUT=60

# Assistente de IA
ASSISTANT_ENABLED=true
ASSISTANT_ENDPOINT=https://api.openai.com/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_MAX_TOKENS=
ASSISTANT_AGENT=
ASSISTANT_HISTORY_LIMIT=40
ASSISTANT_MAX_TOOL_ITERATIONS=6
