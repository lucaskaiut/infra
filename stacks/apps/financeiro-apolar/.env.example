DOMAIN=noxtecnologias.com.br
APP_NAME="Financeiro Apolar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://financeiro-apolar-api.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=financeiro_apolar
DB_USERNAME=financeiro_apolar
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://financeiro-apolar.noxtecnologias.com.br
SANCTUM_STATEFUL_DOMAINS=financeiro-apolar.noxtecnologias.com.br

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"
