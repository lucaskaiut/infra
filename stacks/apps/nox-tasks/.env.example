# Domínio base desta stack (pode diferir do DOMAIN em ~/infra/.env).
# Traefik: tasks-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="Nox Tasks"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://tasks-api.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nox_tasks
DB_USERNAME=nox_tasks
DB_PASSWORD=

# Sanctum SPA (cookie) — front em tasks.noxtecnologias.com.br (Vercel)
FRONTEND_URL=https://tasks.noxtecnologias.com.br
SANCTUM_STATEFUL_DOMAINS=tasks.noxtecnologias.com.br
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=nox_tasks_session
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Billing
BILLING_DAYS_BEFORE_DUE=3
BILLING_PAYMENT_WINDOW_DAYS=3
BILLING_RECURRING_CHARGE_MAX_ATTEMPTS=3
BILLING_RECURRING_CHARGE_RETRY_DELAY_MS=500
BILLING_RECURRING_REMOTE_IP=127.0.0.1

# Asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_USER_AGENT=NoxTasks/1.0
ASAAS_TIMEOUT=30
ASAAS_CREDIT_CARD_TIMEOUT=60

# Assistente de IA (endpoint compatível com OpenAI Chat Completions)
ASSISTANT_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_HISTORY_LIMIT=40
ASSISTANT_MAX_TOOL_ITERATIONS=6
