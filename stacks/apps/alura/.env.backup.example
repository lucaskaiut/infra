# =============================================================================
# Alura Backup — Cloudflare R2 credentials
# =============================================================================
# Copie para .env e preencha com os valores reais.
# NUNCA comite o .env real!

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=seu_access_key_id
R2_SECRET_ACCESS_KEY=seu_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=alura-backups

# --- MySQL (opcional — sobrescreve os defaults) ---
# MYSQL_CONTAINER=<nome_ou_id_do_container_mysql>
# MYSQL_DATABASE=alura
# MYSQL_USER=root
# MYSQL_PASSWORD=<senha_root_do_mysql>

# --- OpenSearch (opcional) ---
# OPENSEARCH_CONTAINER=<nome_ou_id_do_container_opensearch>
# OPENSEARCH_INDEX=products
# OPENSEARCH_URL=http://localhost:9200

# --- Storage (opcional) ---
# ALURA_APP_CONTAINER=<nome_ou_id_do_container_app>
# ALURA_STORAGE_PATH=/var/www/html/storage/app

# --- Retenção ---
# BACKUP_ROOT=/var/backups/alura
# RETENTION_HOURS=24
