# Domínio base desta stack. Traefik: glicosimetro-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="Glicemia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://glicosimetro-api.noxtecnologias.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=glicemia
DB_USERNAME=glicemia
DB_PASSWORD=

# Sanctum SPA (cookie) — front em glicosimetro.noxtecnologias.com.br (Vercel)
FRONTEND_URL=https://glicosimetro.noxtecnologias.com.br
SANCTUM_STATEFUL_DOMAINS=glicosimetro.noxtecnologias.com.br
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=glicemia_session
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Faixas glicêmicas (mg/dL)
GLUCOSE_VERY_LOW=54
GLUCOSE_LOW=70
GLUCOSE_HIGH=180
GLUCOSE_VERY_HIGH=250

ASSISTANT_ENABLED=false
