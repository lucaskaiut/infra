# Domínio base desta stack (usado nos labels do Traefik).
# Traefik: eywa-api.${DOMAIN}
DOMAIN=noxtecnologias.com.br

APP_NAME="EYWA Terapias"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://eywa-api.noxtecnologias.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eywa
DB_USERNAME=eywa
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.noxtecnologias.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
FRONTEND_URL=https://dash-eywa.noxtecnologias.com.br
SANCTUM_STATEFUL_DOMAINS=dash-eywa.noxtecnologias.com.br

# Site público (marketplace) — usado nos links das salas de atendimento
SITE_URL=https://eywa.noxtecnologias.com.br

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Rede interna do stack — não usar o domínio público aqui.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_MAX_MESSAGE_SIZE=32768

# WebRTC (videochamada): STUN público + TURN próprio (coturn)
REALTIME_STUN_URLS=stun:stun.l.google.com:19302
TURN_HOST=eywa-api.noxtecnologias.com.br
TURN_PORT=3478
TURN_SECRET=
TURN_TTL=3600
# IP público da VPS usado pelo coturn para anunciar o relay
TURN_EXTERNAL_IP=194.163.133.41
TURN_REALM=eywa

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Assistente de IA (opcional)
ASSISTANT_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_MAX_TOKENS=

# Asaas (pagamentos) — sandbox por padrão
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
BILLING_ACTIVE_GATEWAYS=asaasPix,asaasCreditCard

# Cookie dos recibos/CSRF do Sanctum (migração)
SESSION_COOKIE=eywa_session
