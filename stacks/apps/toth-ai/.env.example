# Hostname público (HTTPS via Traefik)
TOTH_AI_HOST=toth-ai.lucaskaiut.com.br

# Chave de API (obrigatória; deve começar por sk-). Gere com:
# printf 'LITELLM_MASTER_KEY=sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-substitua-por-chave-forte-aleatoria

# Modelo Ollama transferido no arranque (instruct = respostas diretas, sem reasoning)
OLLAMA_MODEL=qwen3:4b-instruct

# Opcional: transferir também a variante thinking (descomente se precisar de qwen3:4b-thinking)
# OLLAMA_MODEL_EXTRA=qwen3:4b

# Modelo de embeddings (OpenAI-compatible via LiteLLM /v1/embeddings)
OLLAMA_EMBED_MODEL=nomic-embed-text
